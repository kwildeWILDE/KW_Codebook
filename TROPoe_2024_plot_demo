#creating a plot of temperature at a specific height across the week

# Extract and plot temperature data at the different levels of the troposphere 
temp_at_height_l = ds['temperature'].isel(height=27).values # (height index 27 = ~1.21 km)

temp_at_height_m = ds['temperature'].isel(height=47).values # (height index 47 = ~8.72 km)

temp_at_height_u = ds['temperature'].isel(height=54).values # (height index 54 = ~17.09 km)

#extracting and plotting the qc_flags over the time period for the different levels of the troposphere
qc_ind_overall = ds['qc_flag']

times = ds['time'].values

y1 = ds['temperature']
y2 = ds['qc_flag']

fig, ax1 = plt.subplots(figsize=(12, 6))

ax1.plot(times, temp_at_height_l, linewidth=2,color='blue', label='Lower Troposphere ~1.21 km')

ax1.plot(times, temp_at_height_m, linewidth=2, color='green', label='Middle Troposphere ~8.72 km')

ax1.plot(times, temp_at_height_u, linewidth=2, color='red', label='Upper Troposphere ~17.09 km')

ax1.set_xlabel('Time', fontsize=12)
ax1.set_ylabel('Temperature (°C)', fontsize=12)
ax1.legend(loc='upper right', fontsize=10)

ax2 = ax1.twinx()  # Create a second y-axis for QC flags
ax2.plot(times, qc_ind_overall, linewidth=1, color='orange', label='QC Flag', alpha=0.5)
ax2.set_ylabel('QC Flag', fontsize=12)

ax2.legend(loc='upper left', fontsize=10)
plt.title('Temperature Profile at Different Tropospheric Levels', fontsize=14)
plt.grid(True, alpha=0.3)
plt.xticks(rotation=45)

